# Optional: use a YouTube documentary instead of the local MP4.
# Use either a full watch URL or just the 11-character video id.
# Restart the dev server after editing.

# VITE_YOUTUBE_URL=https://www.youtube.com/watch?v=VIDEO_ID
# VITE_YOUTUBE_VIDEO_ID=VIDEO_ID

# Firebase (optional) — copy from Firebase console → Project settings → Your apps → Web app
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Fee text location (defaults shown — only set if you use different names)
# VITE_FEE_COLLECTION=kiosk
# VITE_FEE_DOC_ID=fees
# VITE_FEE_FIELD=content
